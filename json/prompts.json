        "PROMPT_LOAD_CAMPAIGN": {
            "message": "Paste your campaign link (earthborne.build or RangersDB). This will load the current Location, Path Deck, Weather and Missions.",
            "args": [],
            "input": {
                "type": "text"
            },
            "options": [
            {
                "label": "Let's start!",
                "code": [
                    ["VAR", "$URL_INPUT", "$PROMPT_INPUT"],
                    ["COND",
                        ["OR", ["EQUAL", "$URL_INPUT", ""], ["EQUAL", "$URL_INPUT", null]],
                        [
                            ["PROMPT", "$PLAYER_N", "PROMPT_CHOOSE_CYCLE"]
                        ],
                        ["IN_STRING", "$URL_INPUT", "earthborne.build"],
                        [
                            ["VAR", "$PARTS", ["SPLIT_STRING", "$URL_INPUT", "campaign/"]],
                            ["VAR", "$PARTS_LENGTH", ["LENGTH", "$PARTS"]],
                            ["VAR", "$CID",
                                ["COND",
                                    ["EQUAL", "$PARTS_LENGTH", 2],
                                    "$PARTS.[1]",
                                    ["EQUAL", "$PARTS_LENGTH", 1],
                                    "$URL_INPUT",
                                    true,
                                    null
                                ]
                            ],
                            ["COND",
                                ["NOT_EQUAL", "$CID", null],
                                [
                                    ["VAR", "$RESPONSE", ["REQUEST_JSON", "https://earthborne.build/v2/public/campaign/{{$CID}}"]],
                                    ["COND",
                                        ["NOT_EQUAL", "$RESPONSE.campaign", null],
                                        [
                                            ["LOAD_CAMPAIGN_EARTHBORNE", "$RESPONSE.campaign"],
                                            ["LOAD_DECKS_EARTHBORNE", "$RESPONSE.decks"],
                                            ["MARK_REMOVED_CARDS_EARTHBORNE", "$RESPONSE.campaign.removed"]
                                        ],
                                        true,
                                        [
                                            ["LOG", "Could not read campaign data from earthborne.build. Check the link and try again."]
                                        ]
                                    ]
                                ],
                                true,
                                [
                                    ["LOG", "Link not valid."]
                                ]
                            ]
                        ],
                        ["IN_STRING", "$URL_INPUT", "rangersdb.com"],
                        [
                            ["VAR", "$RDB_PARTS", ["SPLIT_STRING", "$URL_INPUT", "campaigns/"]],
                            ["VAR", "$RDB_PARTS_LENGTH", ["LENGTH", "$RDB_PARTS"]],
                            ["COND",
                                ["EQUAL", "$RDB_PARTS_LENGTH", 2],
                                [
                                    ["VAR", "$RDB_CID", ["TO_INT", "$RDB_PARTS.[1]"]],
                                    ["VAR", "$RDB_QUERY", "query getCampaign($campaignId: Int!) { campaign: rangers_campaign_by_pk(id: $campaignId) { id cycle_id current_location current_path_terrain day expansions missions removed __typename } }"],
                                    ["VAR", "$RDB_BODY", ["PROCESS_MAP", {
                                        "operationName": "getCampaign",
                                        "variables": ["PROCESS_MAP", {"campaignId": "$RDB_CID"}],
                                        "query": "$RDB_QUERY"
                                    }]],
                                    ["VAR", "$RDB_RESPONSE", ["REQUEST_POST", "https://gapi.rangersdb.com/v1/graphql", "$RDB_BODY"]],
                                    ["COND",
                                        ["NOT_EQUAL", "$RDB_RESPONSE.data.campaign", null],
                                        [
                                            ["LOAD_CAMPAIGN_EARTHBORNE", "$RDB_RESPONSE.data.campaign"],
                                            ["MARK_REMOVED_CARDS_EARTHBORNE", "$RDB_RESPONSE.data.campaign.removed"],
                                            ["FADE_TEXT_GAME", "Load Ranger decks manually.", 20]
                                        ],
                                        true,
                                        [
                                            ["LOG", "Could not read campaign data from RangersDB. Check the link and try again."]
                                        ]
                                    ]
                                ],
                                true,
                                [
                                    ["LOG", "Link not valid."]
                                ]
                            ]
                        ],
                        true,
                        [
                            ["LOG", "Link not recognized. Paste a campaign link from earthborne.build or rangersdb.com."]
                        ]
                    ]
                ]
            },
            {
                "label": "No, thanks.",
                "code": [
                ["PROMPT", "$PLAYER_N", "PROMPT_CHOOSE_CYCLE"]
                ]
            }
            ]
        },
