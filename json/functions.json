{
    "functions": {
        "SET_CAMPAIGN_MAP": {
          "args": ["$MAP_NAME"],
          "code": [
            // Rimuove eventuali pezzi mappa già in tavola prima di caricare quella nuova
            ["FOR_EACH_VAL", "$OLD_MAP_CARD", "$GAME.groupById.sharedSetAside.parentCards",
              ["COND",
                ["EQUAL", "$OLD_MAP_CARD.sides.A.set", "Map"],
                ["DELETE_CARD", "$OLD_MAP_CARD.id"]
              ]
            ],
            ["LOAD_CARDS", "$MAP_NAME"]
          ]
        },
        "RESOLVE_LOCATION_DECK": {
          "args": ["$LOCATION"],
          "code": [
            ["COND",
              ["AND", ["EQUAL", "$LOCATION", "spire"], "$GAME.spire_in_bloom"],
              "spire2",
              true,
              "$LOCATION"
            ]
          ]
        },
        "SET_SIDE_REGION": {
          "args": ["$SIDE_GROUP_ID"],
          "code": [
            ["LOG", "{{$PLAYER_N}} updated their layout to display {{$GAME.groupById.$SIDE_GROUP_ID.label}}."],
            ["SET", "/playerData/$PLAYER_N/layout/regions/sideRegion/groupId", "$SIDE_GROUP_ID"]
          ]
        },
        "DISCARD_UNTIL": {
            "args": ["$GROUP_ID", "$TYPE"],
            "code": [
                ["LOG", "{{$PLAYER_N}} began discarding until {{$TYPE}}."],
                ["WHILE",
                  ["NOT_EQUAL", "$GAME.groupById.$GROUP_ID.parentCards.[0].sides.A.type", "$TYPE"],
                  [
                    ["DEFINE", "$ACTIVE_CARD_ID", "$GAME.groupById.$GROUP_ID.parentCardIds.[0]"],
                    ["ACTION_LIST", "discardCard"]
                  ]
                ],
                ["VAR", "$TOP_CARD", "$GAME.groupById.$GROUP_ID.parentCards.[0]"],
                ["LOG", "{{$PLAYER_N}} discarded {{$TOP_CARD.sides.A.name}} and added it to the staging area."],
                ["COND",
                    ["EQUAL", "$TOP_CARD.sides.A.reveal", "along_the_way"],
                    ["MOVE_CARD", "$TOP_CARD.id", "sharedAlongTheWay", -1, 0],
                    true,
                    ["MOVE_CARD", "$TOP_CARD.id", "{{$PLAYER_N}}WithinReach", -1, 0]]
            ]
        },
        "SEARCH_NEXT_TYPE": {
            "args": ["$GROUP_ID", "$TYPE"],
            "code": [
              ["VAR", "$i", 0],
              ["FOR_EACH_VAL", "$iCARD", "$GAME.groupById.$GROUP_ID.parentCards", [
                ["COND", 
                    ["AND", 
                        ["LESS_THAN", "$i", 1],
                        ["EQUAL", "$iCARD.sides.A.type", "$TYPE"]
                    ],
                    [["COND",
                      ["EQUAL", "$iCARD.sides.A.reveal", "along_the_way"],
                      ["MOVE_CARD", "$iCARD.id", "sharedAlongTheWay", -1, 0],
                      true,
                      ["MOVE_CARD", "$iCARD.id", "{{$PLAYER_N}}WithinReach", -1, 0]],
                    ["INCREASE_VAR", "$i", 1]]
                ]]
              ],
              ["SHUFFLE_GROUP", "$GROUP_ID"]]
        },
        "DEAL_PATH_CARD": {
          "args": [
            {"$FACE_UP": false},
            {"$GROUP_ID": "sharedPathDeck"},
            {"$PLAYER": "$PLAYER_N"},
            {"$CONTROLLER": "$ALIAS_N"}
          ],
          "code": ["COND",
            ["EQUAL", "$GAME.roundNumber", 0],
            [["INCREASE_VAL", "/roundNumber", 1],
            ["VAR", "$GROUP", "$GAME.groupById.$GROUP_ID"],
            ["COND",
              ["EQUAL", ["LENGTH", "$GROUP.stackIds"], 0],
              ["LOG", "{{$GROUP.label}} is empty."],
              true,
              [
                ["DEFINE", "$CARD_ID", ["GET_CARD_ID", "$GROUP_ID", 0, 0]],
                ["DEFINE", "$CARD", "$GAME.cardById.$CARD_ID"],
                ["COND", 
                ["EQUAL", "$FACE_UP", false],
                [["MOVE_CARD", "$CARD_ID", "sharedAlongTheWay", -1, 0, ["PROCESS_MAP", {"allowFlip": "$FACE_UP"}]],
                ["LOG", "{{$ALIAS_N}} revealed a facedown Path card."]],
                true,
                [["COND",
                    ["EQUAL", "$CARD.sides.A.reveal", "along_the_way"],
                    ["MOVE_CARD", "$CARD_ID", "sharedAlongTheWay", -1, 0],
                    true,
                    ["MOVE_CARD", "$CARD_ID", "{{$PLAYER_N}}WithinReach", -1, 0]],
                ["COND",
                  ["DEFINED", "$CONTROLLER"],
                  ["LOG", "{{$ALIAS_N}} revealed {{$CARD.sides.A.name}}."]]
                ]]
              ]
            ]],
            true,
            [["VAR", "$GROUP", "$GAME.groupById.$GROUP_ID"],
            ["COND",
              ["EQUAL", ["LENGTH", "$GROUP.stackIds"], 0],
              ["LOG", "{{$GROUP.label}} is empty."],
              true,
              [
                ["DEFINE", "$CARD_ID", ["GET_CARD_ID", "$GROUP_ID", 0, 0]],
                ["DEFINE", "$CARD", "$GAME.cardById.$CARD_ID"],
                ["COND", 
                ["EQUAL", "$FACE_UP", false],
                [["MOVE_CARD", "$CARD_ID", "sharedAlongTheWay", -1, 0, ["PROCESS_MAP", {"allowFlip": "$FACE_UP"}]],
                ["LOG", "{{$ALIAS_N}} revealed a facedown Path card."]],
                true,
                [["COND",
                    ["EQUAL", "$CARD.sides.A.reveal", "along_the_way"],
                    ["MOVE_CARD", "$CARD_ID", "sharedAlongTheWay", -1, 0],
                    true,
                    ["MOVE_CARD", "$CARD_ID", "{{$PLAYER_N}}WithinReach", -1, 0]],
                ["COND",
                  ["DEFINED", "$CONTROLLER"],
                  ["LOG", "{{$ALIAS_N}} revealed {{$CARD.sides.A.name}}."]]
                ]]
              ]
            ]]
          ]
        },
        "sufferFatigueForInjury": {
          "args": [
            "$PLAYER"
            ],
          "code": [
              ["DEFINE", "$ROLE_ID", ["GET_CARD_ID", "{{$PLAYER}}Role", 0, 0]],
              ["DEFINE", "$ROLE", "$GAME.cardById.$ROLE_ID"],
              ["COND",
                  ["GREATER_THAN", "$ROLE.tokens.harm", 0],
                  [["FOR_EACH_START_STOP_STEP", "$i", 0, "$ROLE.tokens.harm", 1,
                  [
                      ["MOVE_CARD", ["GET_CARD_ID", "{{$PLAYER}}Deck", 0, 0], "{{$PLAYER}}Fatigue", 0]
                  ]],
                  ["LOG", "{{$GAME.playerInfo.$PLAYER.alias}} suffered ", "$ROLE.tokens.harm", " fatigue."]]
              ]
            ] 
        },
        "DRAW_ONE_CARD": {
          "args": [
            "$PLAYER",
            {"$CONTROLLER": "$GAME.playerInfo.$PLAYER.alias"}],
          "code": [
            ["MOVE_CARD", ["GET_CARD_ID", "{{$PLAYER}}Deck", 0, 0], "{{$PLAYER}}Hand", -1]
          ]
        },
        "CHECK_IF_COPY_IN_PLAY": {
          "args": ["$OUT_OF_PLAY_CARD"],
          "code": [["VAR", "$COPY_IN_PLAY", 
                    ["ONE_CARD", "$CARD", 
                      ["AND", 
                        "$CARD.inPlay", 
                        ["EQUAL", "$CARD.sides.A.name", "$OUT_OF_PLAY_CARD.sides.A.name"]
                      ]
                    ]
                   ],
                   ["NOT_EQUAL", "$COPY_IN_PLAY", null]
            ]  
        }, 
        "CHECK_IF_LOADED_COPY": {
          "args": ["$IN_PLAY_CARD"],
          "code": [
            ["VAR", "$COPY_LOADED", 
              ["ONE_CARD", "$CARD", 
                ["AND", 
                  ["IN_LIST", "$GAME.loadedCardIds", "$CARD.id"],
                  ["AND",
                    ["EQUAL", "$CARD.sides.A.name", "$IN_PLAY_CARD.sides.A.name"],
                    ["EQUAL", "$CARD.sides.A.set", "$IN_PLAY_CARD.sides.A.set"]
                  ]
                ]
              ]
            ],
            ["NOT_EQUAL", "$COPY_LOADED", null]
          ]  
        },
        "UNLOAD_SHARED_CARDS": {
          "args": [],
          "code": [
            ["FOR_EACH_KEY_VAL", "$CARD_ID", "$CARD", "$GAME.cardById", 
              ["COND",
                ["EQUAL", "$CARD.controller", "shared"],
                ["DELETE_CARD", "$CARD_ID"]
              ]
            ]
          ]
        },
        "TRAVEL_TO": {
          "args": ["$LOCATION", "$PATH_SET"],
          "code": [
            ["DEFINE", "$PREV_LOCATION", "$GAME.groupById.sharedLocation.parentCards.[0]"],
            ["UNLOAD_SHARED_CARDS"],
            ["LOAD_CARDS", ["RESOLVE_LOCATION_DECK", "$LOCATION"]],
            ["LOAD_CARDS", "$PATH_SET"],
            ["PROMPT", "$PLAYER_N", "MOMENTS_PROMPT"]
          ]
        },    
        "TOGGLE_ENCOUNTER_2_DECK": {
            "args": ["$VISIBILITY"],
            "code": [
              ["COND",
                "$VISIBILITY",
                [
                  ["LOG", "{{$ALIAS_N}} updated the layout to display the second encounter deck."],
                  ["UPDATE_LAYOUT", "/layout/regions/sharedPathDeck2/visible", true],
                  ["UPDATE_LAYOUT", "/layout/regions/sharedPathDiscard2/visible", true],
                  ["UPDATE_LAYOUT", "/layout/regions/sharedLocation/width", "15%"],
                  ["UPDATE_LAYOUT", "/layout/regions/sharedMissions/left", "48%"],
                  ["UPDATE_LAYOUT", "/layout/regions/sharedMissions/width", "14%"],
                  ["UPDATE_LAYOUT", "/layout/regions/sharedPathDeck/left", "62%"],
                  ["UPDATE_LAYOUT", "/layout/regions/sharedPathDiscard/left", "71.5%"]
      
                ],
                true,
                [
                  ["LOG", "{{$ALIAS_N}} updated the layout to hide the second encounter deck."],
                  ["UPDATE_LAYOUT", "/layout/regions/sharedPathDeck2/visible", false],
                  ["UPDATE_LAYOUT", "/layout/regions/sharedPathDiscard2/visible", false],
                  ["UPDATE_LAYOUT", "/layout/regions/sharedLocation/width", "17.5%"],
                  ["UPDATE_LAYOUT", "/layout/regions/sharedMissions/left", "50.5%"],
                  ["UPDATE_LAYOUT", "/layout/regions/sharedMissions/width", "28%"],
                  ["UPDATE_LAYOUT", "/layout/regions/sharedPathDeck/left", "81%"],
                  ["UPDATE_LAYOUT", "/layout/regions/sharedPathDiscard/left", "90.5%"]
                ]
              ]
            ]
          },
          "SHOW_MULTI_HANDED_GROUP": {
            "args": ["$PLAYER_I", "$SUFFIX"],
            "code": [
              ["VAR", "$GROUP_ID_TO_SHOW", "{{$PLAYER_I}}{{$SUFFIX}}"],
              ["LOG", "{{$ALIAS_N}} updated the layout to show ", ["LABEL", "$GROUP_ID_TO_SHOW"], "."],
              ["UPDATE_LAYOUT", "/layout/regions/{{$PLAYER_I}}Deck/visible", false],
              ["UPDATE_LAYOUT", "/layout/regions/{{$PLAYER_I}}Discard/visible", false],
              ["UPDATE_LAYOUT", "/layout/regions/{{$PLAYER_I}}Fatigue/visible", false],
              ["UPDATE_LAYOUT", "/layout/regions/{{$PLAYER_I}}Deck2/visible", false],
              ["UPDATE_LAYOUT", "/layout/regions/{{$GROUP_ID_TO_SHOW}}/visible", true]
            ]
          },
          "POST_SET_LAYOUT": {
            "args": [],
            "code": [
              ["UPDATE_ADVANCE_BUTTON"],
              ["UPDATE_HELPER_TEXT_VISIBILITY"]
            ]
          },
          "LOAD_CAMPAIGN_EARTHBORNE": {
            "args": ["$CAMPAIGN_DATA"],
            "code": [
                ["DEFINE", "$VALLEY_WEATHER_MAP", {
                  "1": "APerfectDay",
                  "2": "APerfectDay",
                  "3": "APerfectDay",
                  "4": "Downpour",
                  "5": "Downpour",
                  "6": "Downpour",
                  "7": "Downpour",
                  "8": "APerfectDay",
                  "9": "APerfectDay",
                  "10": "Downpour",
                  "11": "Downpour",
                  "12": "Downpour",
                  "13": "HowlingWinds",
                  "14": "HowlingWinds",
                  "15": "Downpour",
                  "16": "Downpour",
                  "17": "Downpour",
                  "18": "HowlingWinds",
                  "19": "HowlingWinds",
                  "20": "HowlingWinds",
                  "21": "APerfectDay",
                  "22": "APerfectDay",
                  "23": "Downpour",
                  "24": "Downpour",
                  "25": "Downpour",
                  "26": "HowlingWinds",
                  "27": "HowlingWinds",
                  "28": "HowlingWinds",
                  "29": "APerfectDay",
                  "30": "APerfectDay"
                }],
                ["DEFINE", "$ARCOLOGY_WEATHER_MAP", {
                  "1": "EnvelopingSilence",
                  "2": "EnvelopingSilence",
                  "3": "EnvelopingSilence",
                  "4": "Glitterain",
                  "5": "Glitterain",
                  "6": "Glitterain",
                  "7": "ShimmeringRunoff",
                  "8": "ShimmeringRunoff",
                  "9": "EnvelopingSilence",
                  "10": "EnvelopingSilence",
                  "11": "EnvelopingSilence",
                  "12": "EnvelopingSilence",
                  "13": "Glitterain",
                  "14": "Glitterain",
                  "15": "Glitterain",
                  "16": "EnvelopingSilence",
                  "17": "EnvelopingSilence",
                  "18": "EnvelopingSilence",
                  "19": "Glitterain",
                  "20": "Glitterain",
                  "21": "Glitterain",
                  "22": "ShimmeringRunoff",
                  "23": "ShimmeringRunoff",
                  "24": "EnvelopingSilence",
                  "25": "EnvelopingSilence",
                  "26": "EnvelopingSilence",
                  "27": "EnvelopingSilence",
                  "28": "Glitterain",
                  "29": "Glitterain",
                  "30": "Glitterain"
                }],
          // SETTING CURRENT CAMPAIGN
                ["COND",
                  ["EQUAL", "$CAMPAIGN_DATA.cycle_id", "loa"],
                  ["SET", "/current_campaign", "loa"],
                  ["EQUAL", "$CAMPAIGN_DATA.cycle_id", "core"],
                  ["SET", "/current_campaign", "core"]
                ],
          // SETTING EXPANSIONS OWNED
                // RangersDB non compila questo campo (resta null): in quel caso non tocchiamo le
                // impostazioni esistenti, per non disattivare espansioni possedute per errore.
                ["COND",
                  // In Legacy of the Ancestors non si può essere anche in Spire in Bloom / Shadow of the Storm
                  ["EQUAL", "$CAMPAIGN_DATA.cycle_id", "loa"],
                  [
                    ["SET", "/spire_in_bloom", false],
                    ["SET", "/shadow_of_the_storm", false]
                  ],
                  ["NOT_EQUAL", "$CAMPAIGN_DATA.expansions", null],
                  [
                    ["SET", "/spire_in_bloom", ["IN_LIST", "$CAMPAIGN_DATA.expansions", "sib"]],
                    ["SET", "/shadow_of_the_storm", ["IN_LIST", "$CAMPAIGN_DATA.expansions", "sos"]]
                  ]
                ],
          // LOADING CARDS
                ["COND",                                                // LOCATION (può essere null a inizio campagna)
                  ["NOT_EQUAL", "$CAMPAIGN_DATA.current_location", null],
                  ["LOAD_CARDS", ["RESOLVE_LOCATION_DECK", "$CAMPAIGN_DATA.current_location"]]
                ],
          // MAP (surface vs underground/Arcology): usa cycle_id se noto, altrimenti si adatta al
          // pack_code della location appena caricata (stesso criterio di $MAP_ROUTES per i viaggi).
                ["VAR", "$MAP_TO_LOAD",
                  ["COND",
                    ["EQUAL", "$CAMPAIGN_DATA.cycle_id", "loa"],
                    "ArcologyMap",
                    ["EQUAL", "$CAMPAIGN_DATA.cycle_id", "core"],
                    "CoreMap",
                    true,
                    ["COND",
                      ["EQUAL", "$GAME.groupById.sharedLocation.parentCards.[0].sides.A.pack_code", "LoA"],
                      "ArcologyMap",
                      true,
                      "CoreMap"
                    ]
                  ]
                ],
                ["SET_CAMPAIGN_MAP", "$MAP_TO_LOAD"],
                ["COND",                                                // PATH SET (può essere null a inizio campagna)
                  ["NOT_EQUAL", "$CAMPAIGN_DATA.current_path_terrain", null],
                  ["LOAD_CARDS", "$CAMPAIGN_DATA.current_path_terrain"]
                ],
                ["COND",                                                // WEATHER
                  ["EQUAL", "$CAMPAIGN_DATA.cycle_id", "core"],
                  [
                    ["DEFINE", "$WEATHER_SET", "$VALLEY_WEATHER_MAP.{{$CAMPAIGN_DATA.day}}"],
                    ["LOAD_CARDS", "$WEATHER_SET"]
                  ],
                  ["EQUAL", "$CAMPAIGN_DATA.cycle_id", "loa"],
                  [
                    ["DEFINE", "$WEATHER_SET", "$ARCOLOGY_WEATHER_MAP.{{$CAMPAIGN_DATA.day}}"],
                    ["LOAD_CARDS", "$WEATHER_SET"],
                    ["COND",
                      ["EQUAL", "$WEATHER_SET", "EnvelopingSilence"],
                      ["LOAD_CARDS", ["LIST", {"databaseId": "01374", "quantity": 1,"loadGroupId": "sharedSetAside"}]],
                      ["EQUAL", "$WEATHER_SET", "Glitterain"],
                      ["LOAD_CARDS", ["LIST", {"databaseId": "01373", "quantity": 1,"loadGroupId": "sharedSetAside"}]],
                      ["EQUAL", "$WEATHER_SET", "ShimmeringRunoff"],
                      ["LOAD_CARDS", ["LIST", {"databaseId": "01375", "quantity": 1,"loadGroupId": "sharedSetAside"}]]
                    ]
                  ]
                ],
          // MISSIONS
                ["VAR", "$MISSION_LOAD_LIST", ["LIST"]],
                ["VAR", "$MISSING_MISSION_NAMES", ["LIST"]],
                ["FOR_EACH_VAL", "$MISSION", "$CAMPAIGN_DATA.missions",
                  [
          // RangersDB fornisce "completed" (earthborne.build no, ma filtra già lato server):
          // saltiamo del tutto le missioni già completate, senza nemmeno tentare di caricarle.
                    ["COND",
                      ["NOT_EQUAL", "$MISSION.completed", true],
                      [
                        ["VAR", "$CARD_CODE", "$MISSION.card_code"],
                        ["COND",
                          ["NOT_EQUAL", "$CARD_CODE", null],
                          [
                            ["VAR", "$LOCAL_ID", ["EB_TO_LOCAL_ID", "$CARD_CODE"]],
                            ["COND",
                              ["AND", ["NOT_EQUAL", "$LOCAL_ID", null], ["DEFINED", "$CARD_DB.{{$LOCAL_ID}}"]],
                              [
                                ["UPDATE_VAR", "$MISSION_LOAD_LIST", ["APPEND", "$MISSION_LOAD_LIST", ["PROCESS_MAP", {"databaseId": "$LOCAL_ID", "quantity": 1, "loadGroupId": "sharedMissions"}]]]
                              ],
                              true,
                              [
                                ["LOG", "├── ", "Mission not found in local database, skipped: {{$MISSION.name}} ({{$CARD_CODE}})."],
                                ["UPDATE_VAR", "$MISSING_MISSION_NAMES", ["APPEND", "$MISSING_MISSION_NAMES", "$MISSION.name"]]
                              ]
                            ]
                          ],
                          true,
                          [
                            // RangersDB non fornisce card_code, solo il nome (spesso con annotazioni tipo
                            // "Search (Lunn)"): cerchiamo nel $CARD_DB una carta Mission il cui nome (o lato,
                            // per le carte a due facce) sia contenuto nel testo. In caso di più corrispondenze
                            // preferiamo quella più lunga/specifica; a parità di lunghezza è ambiguo e saltiamo.
                            // RangersDB a volte usa apostrofi curvi (’/‘) invece di quello dritto
                            // usato dal tuo database: li normalizziamo entrambi prima di confrontare.
                            ["VAR", "$MISSION_NAME_NORM", ["REGEX_REPLACE", ["REGEX_REPLACE", ["TO_LOWERCASE", "$MISSION.name"], "’", "'"], "‘", "'"]],
                            ["VAR", "$BEST_LEN", -1],
                            ["VAR", "$BEST_IDS", ["LIST"]],
                            ["FOR_EACH_KEY_VAL", "$DB_ID", "$DB_CARD", "$CARD_DB",
                              [
                                ["COND",
                                  ["AND", ["EQUAL", "$DB_CARD.A.type", "Mission"], ["NOT_EQUAL", "$DB_CARD.A.name", null]],
                                  [
                                    ["FOR_EACH_VAL", "$NAME_PART", ["SPLIT_STRING", "$DB_CARD.A.name", " / "],
                                      [
                                        ["VAR", "$PART_NORM", ["REGEX_REPLACE", ["REGEX_REPLACE", ["TO_LOWERCASE", "$NAME_PART"], "’", "'"], "‘", "'"]],
                                        ["COND",
                                          ["IN_STRING", "$MISSION_NAME_NORM", "$PART_NORM"],
                                          [
                                            ["VAR", "$PART_LEN", ["LENGTH", "$PART_NORM"]],
                                            ["COND",
                                              ["GREATER_THAN", "$PART_LEN", "$BEST_LEN"],
                                              [
                                                ["UPDATE_VAR", "$BEST_LEN", "$PART_LEN"],
                                                ["UPDATE_VAR", "$BEST_IDS", ["LIST", "$DB_ID"]]
                                              ],
                                              ["EQUAL", "$PART_LEN", "$BEST_LEN"],
                                              // Non riaggiungere lo stesso ID (carte con lo stesso nome su entrambi i lati)
                                              ["COND",
                                                ["NOT", ["IN_LIST", "$BEST_IDS", "$DB_ID"]],
                                                ["UPDATE_VAR", "$BEST_IDS", ["APPEND", "$BEST_IDS", "$DB_ID"]]
                                              ]
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ],
                            ["COND",
                              ["EQUAL", ["LENGTH", "$BEST_IDS"], 1],
                              [
                                ["UPDATE_VAR", "$MISSION_LOAD_LIST", ["APPEND", "$MISSION_LOAD_LIST", ["PROCESS_MAP", {"databaseId": ["AT_INDEX", "$BEST_IDS", 0], "quantity": 1, "loadGroupId": "sharedMissions"}]]]
                              ],
                              true,
                              [
                                ["LOG", "├── ", "Mission not found in local database, skipped: {{$MISSION.name}}."],
                                ["UPDATE_VAR", "$MISSING_MISSION_NAMES", ["APPEND", "$MISSING_MISSION_NAMES", "$MISSION.name"]]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ],
                ["LOAD_CARDS", "$MISSION_LOAD_LIST"],
                ["COND",
                  ["GREATER_THAN", ["LENGTH", "$MISSING_MISSION_NAMES"], 0],
                  [
                    ["FADE_TEXT_GAME", "Missions not found - check log.", 20]
                  ]
                ]
            ]
          },
          "LOAD_DECKS_EARTHBORNE": {
            "args": ["$DECKS"],
            "code": [
                ["VAR", "$PLAYER_INDEX", 1],
                ["FOR_EACH_VAL", "$DECK", "$DECKS",
                  [
                    ["VAR", "$CURRENT_PLAYER", "player{{$PLAYER_INDEX}}"],
                    ["VAR", "$LOAD_LIST", ["LIST"]],
          // ROLE
                    ["VAR", "$ROLE_LOCAL_ID", ["EB_TO_LOCAL_ID", "$DECK.role_code"]],
                    ["COND",
                      ["AND", ["NOT_EQUAL", "$ROLE_LOCAL_ID", null], ["DEFINED", "$CARD_DB.{{$ROLE_LOCAL_ID}}"]],
                      ["UPDATE_VAR", "$LOAD_LIST", ["APPEND", "$LOAD_LIST", ["PROCESS_MAP", {"databaseId": "$ROLE_LOCAL_ID", "quantity": 1, "loadGroupId": "{{$CURRENT_PLAYER}}Role"}]]],
                      true,
                      ["LOG", "├── ", "Role not found in local database, skipped: {{$DECK.role_code}}."]
                    ],
          // ASPECT
                    ["VAR", "$ASPECT_LOCAL_ID", ["EB_TO_LOCAL_ID", "$DECK.aspect_code"]],
                    ["COND",
                      ["AND", ["NOT_EQUAL", "$ASPECT_LOCAL_ID", null], ["DEFINED", "$CARD_DB.{{$ASPECT_LOCAL_ID}}"]],
                      ["UPDATE_VAR", "$LOAD_LIST", ["APPEND", "$LOAD_LIST", ["PROCESS_MAP", {"databaseId": "$ASPECT_LOCAL_ID", "quantity": 1, "loadGroupId": "{{$CURRENT_PLAYER}}Aspect"}]]],
                      true,
                      ["LOG", "├── ", "Aspect not found in local database, skipped: {{$DECK.aspect_code}}."]
                    ],
          // DECK CARDS
                    ["FOR_EACH_KEY_VAL", "$CARD_CODE", "$QUANTITY", "$DECK.slots",
                      [
                        ["VAR", "$LOCAL_ID", ["EB_TO_LOCAL_ID", "$CARD_CODE"]],
                        ["COND",
                          ["AND", ["NOT_EQUAL", "$LOCAL_ID", null], ["DEFINED", "$CARD_DB.{{$LOCAL_ID}}"]],
                          ["UPDATE_VAR", "$LOAD_LIST", ["APPEND", "$LOAD_LIST", ["PROCESS_MAP", {"databaseId": "$LOCAL_ID", "quantity": "$QUANTITY", "loadGroupId": "{{$CURRENT_PLAYER}}Deck"}]]],
                          true,
                          ["LOG", "├── ", "Card not found in local database, skipped: {{$CARD_CODE}}."]
                        ]
                      ]
                    ],
                    ["LOAD_CARDS", "$LOAD_LIST"],
                    ["UPDATE_VAR", "$PLAYER_INDEX", ["ADD", "$PLAYER_INDEX", 1]]
                  ]
                ]
            ]
          },
          "MARK_REMOVED_CARDS_EARTHBORNE": {
            "args": ["$REMOVED_LIST"],
            "code": [
                ["FOR_EACH_VAL", "$REMOVED_ENTRY", "$REMOVED_LIST",
                  [
                    ["VAR", "$TARGET_NAME_LOWER", ["TO_LOWERCASE", "$REMOVED_ENTRY.name"]],
                    ["VAR", "$FOUND_ANY", false],
                    // RangersDB non fornisce "action" (solo name/set_id): in quel caso omettiamo il suffisso.
                    ["VAR", "$ACTION_SUFFIX",
                      ["COND",
                        ["NOT_EQUAL", "$REMOVED_ENTRY.action", null],
                        " (action: {{$REMOVED_ENTRY.action}})",
                        true,
                        ""
                      ]
                    ],
                    ["FOR_EACH_KEY_VAL", "$DB_ID", "$DB_CARD", "$CARD_DB",
                      [
                        ["COND",
                          ["AND",
                            ["NOT_EQUAL", "$DB_CARD.A.name", null],
                            ["NOT_EQUAL", "$DB_CARD.A.set", null],
                            ["EQUAL", ["TO_LOWERCASE", "$DB_CARD.A.name"], "$TARGET_NAME_LOWER"],
                            // Non marcare mai la copia "Reward" (carta del giocatore) come rimossa: earthborne.build
                            // si riferisce sempre alla copia "nemico" (l'altro set) quando rimuove/sposta una carta.
                            ["NOT", ["IN_LIST", ["LIST", "reward", "rewards"], ["TO_LOWERCASE", "$DB_CARD.A.set"]]]
                          ],
                          [
                            ["VAR", "$SET_NORM", ["REGEX_REPLACE", ["TO_LOWERCASE", "$DB_CARD.A.set"], " ", "_"]],
                            ["VAR", "$REMOVED_KEY", "{{$TARGET_NAME_LOWER}}_{{$SET_NORM}}"],
                            ["SET", "/removedCards/{{$REMOVED_KEY}}", true],
                            ["UPDATE_VAR", "$FOUND_ANY", true],
                            ["LOG", "├── ", "Marked as removed: {{$REMOVED_ENTRY.name}} [{{$DB_CARD.A.set}}]{{$ACTION_SUFFIX}}."]
                          ]
                        ]
                      ]
                    ],
                    ["COND",
                      ["NOT", "$FOUND_ANY"],
                      ["LOG", "├── ", "Removed card not found in local database, skipped: {{$REMOVED_ENTRY.name}}."]
                    ]
                  ]
                ]
